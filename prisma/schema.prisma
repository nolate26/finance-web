// ==========================================
// SECCIÓN: COMPANY DEEP DIVE (NUEVAS TABLAS)
// ==========================================

// ─── Tabla 1: Valuación histórica (SERIE MENSUAL, 10Y) ────────────────────
model ValuationHistory {
  ticker      String
  date        DateTime @db.Date
  peFwd       Float?
  evEbitdaFwd Float?
  pbv         Float?
  roeFwd      Float?

  // @@index([date]) se mantiene: NO es prefijo de la PK, y las vistas filtran por fecha.
  @@id([ticker, date])
  @@index([date])
  @@map("valuation_history")
}

// ─── Tabla 2: Consenso de estimaciones (SERIE mensual) ───────────────────
model ConsensusEstimate {
  ticker  String
  date    DateTime @db.Date
  metric  String
  period  String   // AHORA: '1FY' o '2FY' (antes '2026Y')
  value   Float

  // (ticker, metric) y (period) NO son prefijos de la PK → se conservan.
  // El @@index([ticker]) sí lo era y se eliminó.
  @@id([ticker, date, metric, period])
  @@index([ticker, metric])
  @@index([period])
  @@map("consensus_estimates")
}

// ─── Tabla 3: Precio vs Net Income (SERIE MENSUAL 5Y, solo 1BF blended) ────────────────────────
model PriceVsEarnings {
  ticker  String
  date    DateTime @db.Date
  pxLast  Float
  ni1bf   Float?   // NUEVO: Net Income blended 12m

  @@id([ticker, date])
  @@index([date])
  @@map("price_vs_earnings")
}

// ─── Tabla 4: Short Interest (FOTO acumulada) ────────────────────────────
model ShortInterest {
  ticker        String
  date          DateTime @db.Date
  shortIntRatio Float

  @@id([ticker, date])
  @@map("short_interest")
}

// ─── Tabla 5: Rango 52 semanas (FOTO acumulada) ─────────────────────────
model PriceRange52w {
    ticker   String
    date     DateTime @db.Date
    pxLast   Float            // requerido, sin ?
    high52w  Float?           // ahora opcional
    low52w   Float?           // ahora opcional
    pctRange Float?

    @@id([ticker, date])
    @@map("price_range_52w")
}

// ─── Tabla 6: Recomendaciones de analistas (FOTO acumulada) ──────────────
model AnalystRecommendation {
  ticker      String
  date        DateTime @db.Date
  totAnalysts Int
  buy         Int      @default(0)
  hold        Int      @default(0)
  sell        Int      @default(0)
  consenso    String?
  targetPrice Float?   // <--- NUEVO CAMPO AGREGADO

  @@id([ticker, date])
  @@map("analyst_recommendations")
}
// ─── Tracking de corridas incrementales ──────────────────────────────────
model LastRun {
  id       Int    @id @default(autoincrement())
  ticker   String
  module   String
  lastDate String

  @@unique([ticker, module])
  @@map("last_run")
}

model SignalRaw {
  signalDate DateTime @map("signal_date") @db.Date
  ticker     String   @db.VarChar(100) // Ticker Bloomberg

  // Factores y Scores
  score      Float?
  value      Float?
  quality    Float?

  // Métricas
  pe         Float?
  dy         Float?
  roe        Float?
  deltaRoe   Float?   @map("delta_roe") // Para tu ΔROE
  price      Float?

  // Flags
  top20      Boolean? // True si la empresa entró al Top 20 esa semana

  // @@index([signalDate]) eliminado: es prefijo de la PK. El de ticker no lo es → se conserva.
  @@id([signalDate, ticker])
  @@index([ticker])
  @@map("signals_raw")
}

