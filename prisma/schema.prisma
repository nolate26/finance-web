generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}
// ==========================================
// SECCIÓN: SEGURIDAD Y USUARIOS (NextAuth)
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // ¡Añadido para login tradicional!
  role          String    @default("user")   // "admin" | "user" — controla permisos de edición
  image         String?
  // Sigla del analista en el calendario semanal ("DM", "AP", "RZ"). Es el puente entre
  // la grilla macro y la grilla de analistas: la celda muestra estas siglas, no nombres.
  // Único (Postgres permite varios NULL): dos analistas con la misma sigla harían
  // ambigua la grilla. NULL = usuario que no aparece en el calendario.
  initials      String?   @unique @db.VarChar(8)
  accounts      Account[]
  sessions      Session[]

  weeklyPlans   WeeklyPlanAnalyst[]
  sectors       SectorMember[]
  pickSectors   PickSectorMember[]
  topPicks      TopPick[]     @relation("TopPickAuthor")
  tasksAssigned Task[]        @relation("TaskAssignee")
  tasksCreated  Task[]        @relation("TaskCreator")
  taskComments  TaskComment[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}


// ==========================================
// SECCIÓN: FONDOS Y UNIVERSO
// ==========================================

model FundPortfolioWeight {
  fundName        String   @map("fund_name") @db.VarChar(100)
  reportDate      DateTime @map("report_date") @db.Date
  company         String   @db.VarChar(200)
  portfolioWeight Float?   @map("portfolio_weight")
  benchmarkName   String?  @map("benchmark_name") @db.VarChar(100)
  benchmarkWeight Float?   @map("benchmark_weight")
  overweight      Float?

  @@id([fundName, reportDate, company])
  @@map("fund_portfolio_weights")
}

model PerformanceAttribution {
  reportDate     DateTime @map("report_date") @db.Date
  fund           String   @db.VarChar(200)
  security       String   @db.VarChar(200)
  sourceFile     String?  @map("source_file") @db.VarChar(255)
  benchmark      String?  @db.VarChar(200)
  fundAvgWeight  Float?   @map("fund_avg_weight")
  fundContrib    Float?   @map("fund_contrib")
  benchAvgWeight Float?   @map("bench_avg_weight")
  benchContrib   Float?   @map("bench_contrib")
  selectEffect   Float?   @map("select_effect")
  allocEffect    Float?   @map("alloc_effect")
  totalEffect    Float?   @map("total_effect")
  rowType        String?  @map("row_type") @db.VarChar(50)

  @@id([reportDate, fund, security])
  @@map("performance_attribution")
}
// ==========================================
// SECCIÓN: TOP PICKS
// ==========================================
// Vive bajo Analyst Estimates (pestañas "Top Picks Chile" y "Top Picks LatAm/Brazil").
//
// Se agrupa por SECTOR con su propia lista, separada de la de Team Planning: son ejes
// que se parecen hoy pero evolucionan por separado, y acoplarlos haría que sacar a
// alguien de un sector de tareas le apagara los picks sin que nadie lo pidiera.

model PickSector {
  id          String   @id @default(cuid())
  // Los sectores son POR REGIÓN: Chile y LatAm mantienen listas independientes.
  // Sin esto el nombre era único global y las dos regiones competían por él —
  // "Banks" de Chile obligaba a llamar "Bank" al de LatAm—, y borrar un sector en
  // una región se lo llevaba de la otra.
  region      String   @db.VarChar(20)            // "CHILE" | "LATAM"
  name        String   @db.VarChar(120)           // "Retail", "Financials", …
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(200)

  members PickSectorMember[]
  picks   TopPick[]

  // Único DENTRO de su región: Chile y LatAm pueden tener cada uno su "Banks".
  @@unique([region, name])
  @@index([region, sortOrder])
  @@map("pick_sectors")
}

// Puente N:M sector ↔ analistas. Decide DOS cosas:
//   · quién puede agregar picks en ese sector, y
//   · qué picks se ven activos: uno cuyo autor ya no figura acá queda LEGACY.
// El estado legacy no se guarda en ninguna columna, se deriva de esta tabla. Así el
// día que sacas a un analista sus picks se ponen grises solos, sin update masivo ni
// un flag que alguien olvide cambiar.
model PickSectorMember {
  sectorId String   @map("sector_id")
  userId   String   @map("user_id")
  addedAt  DateTime @default(now()) @map("added_at")

  sector PickSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@id([sectorId, userId])
  @@index([userId])
  @@map("pick_sector_members")
}

model TopPick {
  id            String   @id @default(cuid())
  region        String   @db.VarChar(20)   // "CHILE" | "LATAM"
  periodDate    DateTime @map("period_date") @db.Date  // el mes del reporte

  nombreLatam   String   @map("nombre_latam") @db.VarChar(200)
  comment       String   @db.Text
  targetPrice   Float?   @map("target_price")

  // Agrupación estructural. NULLABLE por la migración: los 101 picks heredados no
  // traen sector y se muestran en un bucket "Unassigned" hasta que el admin los
  // reparta. Un pick sin sector nunca es legacy — sencillamente está sin clasificar.
  sectorId      String?  @map("sector_id")

  // AUTORÍA EN DOS PIEZAS, y ésta es la clave de la retención histórica:
  //   authorId   — FK viva. Sólo sirve para preguntar "¿sigue siendo miembro?".
  //   authorName — copia CONGELADA del nombre, escrita al crear el pick. Es lo que
  //                sobrevive si el usuario se borra, y lo único que existe para
  //                quienes ya se fueron (Harry Klenner tiene 6 picks y no está en
  //                users, así que una FK sola habría perdido su nombre para siempre).
  // Nullable porque los picks heredados no tienen autor identificable.
  authorId      String?  @map("author_id")
  authorName    String?  @map("author_name") @db.VarChar(120)

  // GICS. Antes cargaba dos roles a la vez —industria real en 74 filas y NOMBRE DE
  // ANALISTA en 27—; ese segundo uso pasó a authorName/sectorId y acá queda sólo la
  // industria, ya como dato descriptivo y no estructural.
  industryGroup String?  @map("industry_group") @db.VarChar(200)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Las DOS en SetNull, al revés que en tasks: acá el objetivo es el opuesto. Borrar
  // un usuario o un sector NO debe bloquearse ni llevarse el pick; el historial lo
  // sostiene authorName, que no depende de que la FK siga en pie.
  sector PickSector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  author User?       @relation("TopPickAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // Una empresa no se puede recomendar dos veces en el mismo reporte, ni siquiera
  // desde sectores distintos.
  @@unique([region, periodDate, nombreLatam])
  @@index([sectorId, periodDate])
  @@index([region, periodDate])
  @@map("top_picks")
}


// ─── Tabla 7: Total Return Index con dividendos brutos ───────────────────
model TotalReturnIndex {
  ticker String
  date DateTime @db.Date
  triToday Float? @map("tri_today")
  tri1m Float? @map("tri_1m")
  tri3m Float? @map("tri_3m")
  tri6m Float? @map("tri_6m")
  tri1y Float? @map("tri_1y")
  tri2y Float? @map("tri_2y")

  // PK natural: (ticker, date) ya era la llave real. El `id` autoincremental no lo
  // referenciaba nadie y duplicaba un índice. El @@index([ticker]) sobraba: es prefijo de la PK.
  @@id([ticker, date])
  @@map("total_return_index")
}

