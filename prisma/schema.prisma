// ==========================================
// SECCIÓN: COMPANY DEEP DIVE (NUEVAS TABLAS)
// ==========================================

// ─── Tabla 1: Valuación histórica (SERIE MENSUAL, 10Y) ────────────────────
model ValuationHistory {
  ticker      String
  date        DateTime @db.Date
  peFwd       Float?
  evEbitdaFwd Float?
  pbv         Float?
  roeFwd      Float?

  // @@index([date]) se mantiene: NO es prefijo de la PK, y las vistas filtran por fecha.
  @@id([ticker, date])
  @@index([date])
  @@map("valuation_history")
}

// ─── Tabla 2: Consenso de estimaciones (SERIE mensual) ───────────────────
model ConsensusEstimate {
  ticker  String
  date    DateTime @db.Date
  metric  String
  period  String   // AHORA: '1FY' o '2FY' (antes '2026Y')
  value   Float

  // (ticker, metric) y (period) NO son prefijos de la PK → se conservan.
  // El @@index([ticker]) sí lo era y se eliminó.
  @@id([ticker, date, metric, period])
  @@index([ticker, metric])
  @@index([period])
  @@map("consensus_estimates")
}

// ─── Tabla 3: Precio vs Net Income (SERIE MENSUAL 5Y, solo 1BF blended) ────────────────────────
model PriceVsEarnings {
  ticker  String
  date    DateTime @db.Date
  pxLast  Float
  ni1bf   Float?   // NUEVO: Net Income blended 12m

  @@id([ticker, date])
  @@index([date])
  @@map("price_vs_earnings")
}

// ─── Tabla 4: Short Interest (FOTO acumulada) ────────────────────────────
model ShortInterest {
  ticker        String
  date          DateTime @db.Date
  shortIntRatio Float

  @@id([ticker, date])
  @@map("short_interest")
}

// ─── Tabla 5: Rango 52 semanas (FOTO acumulada) ─────────────────────────
model PriceRange52w {
    ticker   String
    date     DateTime @db.Date
    pxLast   Float            // requerido, sin ?
    high52w  Float?           // ahora opcional
    low52w   Float?           // ahora opcional
    pctRange Float?

    @@id([ticker, date])
    @@map("price_range_52w")
}

// ─── Tabla 6: Recomendaciones de analistas (FOTO acumulada) ──────────────
model AnalystRecommendation {
  ticker      String
  date        DateTime @db.Date
  totAnalysts Int
  buy         Int      @default(0)
  hold        Int      @default(0)
  sell        Int      @default(0)
  consenso    String?
  targetPrice Float?   // <--- NUEVO CAMPO AGREGADO

  @@id([ticker, date])
  @@map("analyst_recommendations")
}
// ─── Tracking de corridas incrementales ──────────────────────────────────
model LastRun {
  id       Int    @id @default(autoincrement())
  ticker   String
  module   String
  lastDate String

  @@unique([ticker, module])
  @@map("last_run")
}

model SignalRaw {
  signalDate DateTime @map("signal_date") @db.Date
  ticker     String   @db.VarChar(100) // Ticker Bloomberg

  // Factores y Scores
  score      Float?
  value      Float?
  quality    Float?

  // Métricas
  pe         Float?
  dy         Float?
  roe        Float?
  deltaRoe   Float?   @map("delta_roe") // Para tu ΔROE
  price      Float?

  // Flags
  top20      Boolean? // True si la empresa entró al Top 20 esa semana

  // @@index([signalDate]) eliminado: es prefijo de la PK. El de ticker no lo es → se conserva.
  @@id([signalDate, ticker])
  @@index([ticker])
  @@map("signals_raw")
}

model MomentumSignal {

  signalDate DateTime @map("signal_date") @db.Date
  ticker     String   @db.VarChar(100) // Ticker Bloomberg

  // Señal de momentum (skip-return 315-15, total return USD)
  signal     Float?   // retorno acumulado de la ventana [t-315, t-15], en %
  score      Float?   // puntaje rank-percentil 0-100 (rank 1 = 100)
  zscore     Float?   @map("z_score") // sigmas vs media cross-section de la fecha
  rank       Int?     // puesto ordinal (1 = mejor momentum)

  // @@index([signalDate]) eliminado: es prefijo de la PK.
  @@id([signalDate, ticker])
  @@index([ticker])
  @@map("momentum_signals")

}
 



 
model BenchmarkMxla {
  date DateTime @id @map("date") @db.Date
  pxClose Float? @map("px_close") // MXLA Index PX_LAST
 
  @@map("benchmark_mxla")
}

model Presentation {
  id           String   @id @default(uuid())
  title        String
  description  String?
  file_url     String
  category     String   // ej: 'Investment Cases', 'Client Presentations'
  region       String   // ej: 'Chile', 'LATAM'
  company_name String?  // Opcional: para vincularlo a un ticker o empresa
  is_sell_side Boolean  @default(false) // <--- NUEVO CAMPO AÑADIDO
  created_at   DateTime @default(now())

  @@map("presentations") // (Opcional) para que la tabla en Postgres se llame en minúsculas y plural
}


// ==========================================
// SECCIÓN: EARNINGS SURPRISE & GROWTH
// ==========================================

model EarningsSurprise {
  tickerBloomberg  String   @map("ticker_bloomberg") @db.VarChar(100)
  quarter          String   @db.VarChar(10) // ej: '1Q26', '4Q25'
  reportDate       DateTime @map("report_date") @db.Date

  // --- NUEVOS CAMPOS: Moneda y Valores Reales (Absolutos) ---
  currency         String?  @db.VarChar(10) // ej: 'BRL', 'MXN', 'CLP'
  
  // --- REVENUE (Ventas) ---
  revActual        Float?   @map("rev_actual")    // Valor absoluto reportado
  revBeatMiss      Float?   @map("rev_beat_miss") // % de sorpresa vs Consenso
  revYoy           Float?   @map("rev_yoy")       // Crecimiento Year-over-Year
  revQoq           Float?   @map("rev_qoq")       // Crecimiento Quarter-over-Quarter

  // --- EBITDA ---
  ebitdaActual     Float?   @map("ebitda_actual")
  ebitdaBeatMiss   Float?   @map("ebitda_beat_miss")
  ebitdaYoy        Float?   @map("ebitda_yoy")
  ebitdaQoq        Float?   @map("ebitda_qoq")

  // --- NET INCOME (Utilidades) ---
  niActual         Float?   @map("ni_actual")
  niBeatMiss       Float?   @map("ni_beat_miss")
  niYoy            Float?   @map("ni_yoy")
  niQoq            Float?   @map("ni_qoq")

  @@id([tickerBloomberg, quarter])
  @@map("earnings_surprise")
}

// --- NUEVA TABLA: Tipo de Cambio Promedio Trimestral ---
model QuarterlyFxRate {
  id          Int      @id @default(autoincrement())
  country     String   @db.VarChar(50) // ej: 'Brazil', 'Mexico', 'Chile'
  quarter     String   @db.VarChar(10) // ej: '1Q26'
  currency    String   @db.VarChar(10) // ej: 'BRL', 'MXN'
  avgRate     Float?   @map("avg_rate") // Tipo de cambio promedio del trimestre vs USD

  @@unique([country, quarter, currency])
  @@map("quarterly_fx_rates")
}
// ==========================================
// MODELO ACTUALIZADO - ModelHeader
// ==========================================
model ModelHeader {
  ticker     String   @db.VarChar(100)
  updateDate DateTime @map("update_date") @db.Date
  recc       String?  @db.VarChar(10)
  tp         Float?
  analyst    String?  @db.VarChar(100)
  currency   String?  @db.VarChar(50)
  unit       String?  @map("unit") @db.VarChar(20)   // ← NUEVO (D6)
  thesis     String?  @db.Text
  link       String?  @db.VarChar(500)
  financials ModelFinancials[]
  kpis       ModelKPI[]
  @@id([ticker, updateDate])
  @@map("model_headers")
}



// ==========================================
// MODELO ACTUALIZADO - ModelFinancials
// ==========================================
model ModelFinancials {
  ticker           String   @db.VarChar(100)
  updateDate       DateTime @map("update_date") @db.Date
  year             Int
  
  // FX (nuevos)
  fxConsensus      Float?   @map("fx_consensus")     // ← NUEVO (fila 12)
  fxEop            Float?   @map("fx_eop")           // ← NUEVO (fila 15)
 
  // Income Statement
  revenue          Float?
  ebit             Float?
  taxRate          Float?   @map("tax_rate")
  da               Float?   @map("d_a")
  ebitda           Float?
  netFinExp        Float?   @map("net_fin_expenses")
  taxes            Float?                // ← NUEVO (fila 18)
  netIncome        Float?   @map("net_income")
  eps              Float?
  sharesOut        Float?   @map("shares_out")
  // Balance Sheet
  netDebt          Float?   @map("net_debt")
  minorities       Float?
  controllingEq    Float?   @map("controlling_equity")
  tangibleEq       Float?   @map("tangible_equity")
  ppe              Float?
  workingCapital   Float?   @map("working_capital")
  // Cash Flow
  fcf              Float?
  capex            Float?
  assetSales       Float?   @map("asset_sales")
  fcfe             Float?
  dividend         Float?
  payout           Float?
  buybacks         Float?
  dps              Float?
  sharePrice       Float?   @map("share_price")
  marketCap        Float?   @map("market_cap")
  header           ModelHeader @relation(fields: [ticker, updateDate], references: [ticker, updateDate], onDelete: Cascade)
  @@id([ticker, updateDate, year])
  @@map("model_financials")
}
// ==========================================
// NUEVO MODELO - ModelKPI (Company Specific)
// ==========================================
// La unicidad va por (kpiName + kpiOrder), no por uno solo de los dos:
//   · Solo kpiName  → colisionan las filas que repiten nombre en una sección
//                     ("Var %"), y el loader las descartaba silenciosamente.
//   · Solo kpiOrder → colisionan las secciones que la planilla parte en dos
//                     sub-bloques y reinician el contador (RDOR3, TLEVICPO).
// Con ambos campos las dos formas quedan cubiertas. Misma llave que BankKPI.
//
// `id` se conserva a propósito: NO es una PK sustituta muerta, es el orden de
// visualización. Las rutas model|bank-model leen los KPIs con orderBy:{id:"asc"}
// para respetar el orden de la planilla, que no se puede reconstruir desde
// sectionName/kpiOrder (el orden de las secciones es el de inserción).
model ModelKPI {
  id           Int      @id @default(autoincrement())
  ticker       String   @db.VarChar(100)
  updateDate   DateTime @map("update_date") @db.Date
  year         Int

  // Identificadores de la sección/KPI
  sectionName  String   @map("section_name") @db.VarChar(100)  // Ej: "Argentina", "Brazil Beer"
  kpiName      String   @map("kpi_name") @db.VarChar(100)      // Ej: "Volumes", "Prices", "Revenue", "EBITDA"
  kpiOrder     Int      @map("kpi_order")                      // Orden dentro de la sección

  // Valor del KPI
  value        Float?

  header       ModelHeader @relation(fields: [ticker, updateDate], references: [ticker, updateDate], onDelete: Cascade)
  @@unique([ticker, updateDate, year, sectionName, kpiName, kpiOrder])
  @@map("model_kpis")
}


model EmailResearch {
  id          Int       @id @default(autoincrement())
  schemaVersion String? @map("schema_version") @db.VarChar(10)
  company     String    @db.VarChar(100) // Reemplaza al 'ticker' del ejemplo anterior
  date        DateTime  @db.Date
  category    String    @db.VarChar(100)
  title       String?   @db.VarChar(255)
  subject     String?   @db.Text
  html        String    @db.Text         // El cuerpo final procesado

  // Nuevos campos agregados
  targetPrice   Float?    @map("target_price")
  recommendation String?  @map("recommendation") @db.VarChar(50) // BUY, SELL, HOLD, etc.

  
  // Metadatos del origen
  from        String?   @db.VarChar(255)
  receivedAt  DateTime? @map("received_at")
  messageId   String?   @map("message_id") @db.VarChar(255)

  // Llave natural de la ingesta: un correo puede traer varios tickers y genera una
  // fila por ticker, así que el messageId solo NO identifica la nota — el par sí.
  // Con esto reprocesar la bandeja es idempotente en vez de duplicar todo.
  // (messageId es nullable: en Postgres los NULL no chocan, las notas creadas a mano
  // sin messageId quedan fuera de la restricción, que es el comportamiento deseado.)
  //
  // `id` se conserva: lo usan /api/research/[id] (PATCH y DELETE).
  @@unique([messageId, company])
  @@index([company, date])
  @@map("email_research")
}





// ------------------------------------------
// HEADER (cabecera) — un registro por (ticker, updateDate)
// Mismos campos que el header de compañías, pero tabla aparte.
// ------------------------------------------
model BankHeader {
  ticker      String   @db.VarChar(100)
  updateDate  DateTime @map("update_date") @db.Date

  recc        String?  @db.VarChar(20)   // Buy / Hold / Sell
  tp          Float?                      // Target Price
  analyst     String?  @db.VarChar(100)
  currency    String?  @db.VarChar(20)   // Ej: "CLP mm"
  unit        String?  @db.VarChar(50)   // NUEVO
  thesis      String?  @db.Text
  link        String?  @db.Text

  financials  BankFinancials[]
  kpis        BankKPI[]

  // PK compuesta, igual que ModelHeader: los hijos ya apuntaban a (ticker, updateDate)
  // y el `id` no lo referenciaba nadie. El selector de Prisma sigue siendo
  // `ticker_updateDate`, así que el upsert del ingest no cambia.
  @@id([ticker, updateDate])
  @@map("bank_headers")
}

// ------------------------------------------
// FINANCIALS — una fila por (ticker, updateDate, year)
// Estructura específica de banco (filas 12–60 de la planilla).
// ------------------------------------------
model BankFinancials {
  ticker      String   @db.VarChar(100)
  updateDate  DateTime @map("update_date") @db.Date
  year        Int

  fxConsensus Float? @map("fx_consensus")
  fxEop       Float? @map("fx_eop")

  // --- Income Statement (filas 12–31) ---
  netInterestIncome  Float? @map("net_interest_income")  // 12 Net interest income ($)
  netFeeIncome       Float? @map("net_fee_income")       // 13 Net fee income ($)
  treasuryIncome     Float? @map("treasury_income")      // 14 Treasury income ($)
  otherIncome        Float? @map("other_income")         // 15 Other income ($)
  revenue            Float?                               // 16 Revenue ($)
  nim                Float?                               // 17 NIM (%)
  riskAdjustedNim    Float? @map("risk_adjusted_nim")    // 18 Risk adjusted NIM (%)
  provisionExpenses  Float? @map("provision_expenses")   // 19 Provision expenses ($)
  cor                Float?                               // 20 CoR (%)
  nplRatio           Float? @map("npl_ratio")            // 21 NPL ratio (%)
  totalCoverageRatio Float? @map("total_coverage_ratio") // 22 Total coverage ratio (%)
  sga                Float?                               // 23 SG&A ($)
  efficiency         Float?                               // 24 Efficiency (%)
  costToAssets       Float? @map("cost_to_assets")       // 25 Cost to assets (%)
  ebt                Float?                               // 26 EBT ($)
  taxes              Float?                               // 27 Taxes ($)
  minorityInterest   Float? @map("minority_interest")    // 28 Minority interest ($)
  controllingNetIncome Float? @map("controlling_net_income") // 29 Controlling Net Income ($)
  eps                Float?                               // 30 EPS ($)
  shares             Float?                               // 31 # Shares (mn)

  // --- Balance (filas 33–52) ---
  grossLoans                 Float? @map("gross_loans")                  // 33
  securities                 Float?                                       // 34
  interestEarningAssets      Float? @map("interest_earning_assets")      // 35
  avgInterestEarningAssets   Float? @map("avg_interest_earning_assets")  // 36
  allowancesLoanLosses       Float? @map("allowances_loan_losses")       // 37
  totalAssets                Float? @map("total_assets")                 // 38
  avgTotalAssets             Float? @map("avg_total_assets")             // 39
  demandDeposits             Float? @map("demand_deposits")              // 40
  timeDeposits               Float? @map("time_deposits")                // 41
  totalDeposits              Float? @map("total_deposits")               // 42
  otherFunding               Float? @map("other_funding")                // 43
  interestBearingLiabilities Float? @map("interest_bearing_liabilities") // 44
  totalFunding               Float? @map("total_funding")                // 45
  totalLiabilities           Float? @map("total_liabilities")            // 46
  minorities                 Float?                                       // 47
  controllingEquity          Float? @map("controlling_equity")           // 48
  avgControllingEquity       Float? @map("avg_controlling_equity")       // 49
  tangibleEquity             Float? @map("tangible_equity")              // 50
  overdueLoans               Float? @map("overdue_loans")                // 51
  voluntaryProvisions        Float? @map("voluntary_provisions")         // 52

  // --- Cash Flow / Market (filas 54–60) ---
  capex       Float?                          // 54
  dividend    Float?                          // 55 Dividend ($) - negative
  payout      Float?                          // 56 Payout - positive
  buybacks    Float?                          // 57 Buybacks ($) - negative
  dps         Float?                          // 58 DPS ($) - negative
  sharePrice  Float? @map("share_price")      // 59 Share Price ($) - LCCY
  marketCap   Float? @map("market_cap")       // 60 Market Cap ($) - LCCY

  header      BankHeader @relation(fields: [ticker, updateDate], references: [ticker, updateDate], onDelete: Cascade)

  @@id([ticker, updateDate, year])
  @@map("bank_financials")
}

// ------------------------------------------
// KPI (Company Specific) — filas 62+ de la planilla
// Unicidad por (kpiName + kpiOrder), idéntica a ModelKPI: permite tanto nombres
// repetidos dentro de una sección ("Var %") como contadores de orden que se
// reinician cuando la planilla parte una sección en sub-bloques.
// `id` se conserva como orden de visualización (orderBy:{id:"asc"} en la ruta).
// ------------------------------------------
model BankKPI {
  id          Int      @id @default(autoincrement())
  ticker      String   @db.VarChar(100)
  updateDate  DateTime @map("update_date") @db.Date
  year        Int

  sectionName String   @map("section_name") @db.VarChar(100) // Ej: "Chile", "CNB"
  kpiName     String   @map("kpi_name") @db.VarChar(100)     // Ej: "Commercial loans", "Var %"
  kpiOrder    Int      @map("kpi_order")                      // Orden dentro de la sección

  value       Float?

  header      BankHeader @relation(fields: [ticker, updateDate], references: [ticker, updateDate], onDelete: Cascade)

  @@unique([ticker, updateDate, year, sectionName, kpiName, kpiOrder])
  @@map("bank_kpis")
}


