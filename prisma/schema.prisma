// ==========================================
// SECCIÓN: PLANIFICACIÓN Y GESTIÓN DE TAREAS
// ==========================================
// Dos vistas sobre los mismos datos, en /latam → Planning:
//   · Macro — la grilla semanal del Excel (weekly_plan), una celda por región y semana.
//   · Micro — la grilla de analistas: una caja por persona con su lista de tareas
//            (tasks + task_comments). No hay columnas de estado ni drag & drop.
// A diferencia del resto del schema, estas tablas NO se cargan por /api/ingest: se
// escriben exclusivamente desde la web, así que son la fuente de verdad de sí mismas.

// Calendario macro. Réplica editable de la planilla: una fila por (región, semana),
// que es exactamente una celda de la grilla. Sólo admin escribe; todos leen.
model WeeklyPlan {
  id          String   @id @default(cuid())
  region      String   @db.VarChar(40)   // "CHILE" | "LATAM" — columna de la grilla
  weekStart   DateTime @map("week_start") @db.Date // SIEMPRE el lunes de la semana (se normaliza al escribir)
  topic       String?  @db.VarChar(300)  // "Update: Hapag-Vapores / Quiñenco"
  // Color de la celda. El manual PATRIA no tiene verde ni rojo, así que los colores
  // del Excel se mapean a la paleta corporativa en lib/planningTheme.ts:
  // update (verde→sky) | banks (azul→king) | top_picks (amarillo→naranjo)
  // results (gris→dark-blue) | alert (rojo→pink) | holiday (gris claro) | none (sin relleno)
  category    String   @default("update") @db.VarChar(20)
  // true = "All" en la grilla: la semana es de todo el equipo y se ignoran las filas
  // de weekly_plan_analysts. false + cero analistas = celda sin dueño, se pinta "-".
  allAnalysts Boolean  @default(false) @map("all_analysts")
  highlighted Boolean  @default(false)  // el recuadro rojo del Excel: semana a vigilar
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(200) // users.email del último editor

  analysts    WeeklyPlanAnalyst[]
  tasks       Task[]

  @@unique([region, weekStart])
  @@index([weekStart])
  @@map("weekly_plan")
}

// Puente celda ↔ analistas. Reemplaza al texto libre "DM" / "AP / LB" del Excel:
// la grilla renderiza users.initials de cada fila, unidas por " / ". El caso "All"
// NO vive acá, es el flag weekly_plan.all_analysts.
model WeeklyPlanAnalyst {
  weeklyPlanId String @map("weekly_plan_id")
  userId       String @map("user_id")

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId],       references: [id], onDelete: Cascade)

  @@id([weeklyPlanId, userId])
  @@index([userId])
  @@map("weekly_plan_analysts")
}

// Sector: el eje de la vista micro. Reemplazó a la agrupación por analista — la
// pantalla es una grilla de sectores, no de personas.
//
// La membresía (sector_members) es lo ÚNICO que decide quién puede ESCRIBIR dentro
// de un sector. LEER es abierto: cualquier usuario autenticado ve todos los sectores,
// todas las sub-secciones y todas las tareas del equipo. Crear/renombrar/borrar
// sectores y su membresía es exclusivo de admin.
model Sector {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(300)
  // true = "Coordinación General", el espacio transversal que va arriba de la grilla.
  // Singleton por convención: la API impide crear un segundo y bloquea su borrado.
  // No tiene regla de permisos especial — escribe quien sea miembro, como en cualquier
  // otro sector, así que abrirlo al equipo entero es agregar a todos como miembros.
  isGeneral   Boolean  @default(false) @map("is_general")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(200)

  members  SectorMember[]
  sections SectorSection[]

  @@index([sortOrder])
  @@map("sectors")
}

// Puente N:M sector ↔ analistas. Ser miembro = poder escribir en ese sector; no serlo
// = verlo en modo lectura. Sacar a alguien de un sector NO toca sus tareas: el trabajo
// pertenece al sector, no a la persona.
model SectorMember {
  sectorId String   @map("sector_id")
  userId   String   @map("user_id")
  addedAt  DateTime @default(now()) @map("added_at")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@id([sectorId, userId])
  @@index([userId])
  @@map("sector_members")
}

// Sub-secciones editables dentro de un sector. Al crear un sector la API siembra tres
// en la misma transacción — "Chile", "Latam & Brasil", "Other" — y de ahí en adelante
// el admin las renombra, reordena o agrega otras.
model SectorSection {
  id        String   @id @default(cuid())
  sectorId  String   @map("sector_id")
  name      String   @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([sectorId, name])
  @@index([sectorId, sortOrder])
  @@map("sector_sections")
}

// Una tarea. Vive SIEMPRE dentro de una sub-sección, y por lo tanto dentro de un sector.
model Task {
  id           String    @id @default(cuid())
  title        String    @db.VarChar(300)
  description  String?   @db.Text
  status       String    @default("todo") @db.VarChar(20)   // todo | in_progress | done
  priority     String    @default("medium") @db.VarChar(10) // low | medium | high
  dueDate      DateTime? @map("due_date") @db.Date

  // Ubicación de la tarea. NO se guarda el sector: la sección ya sabe a cuál pertenece,
  // y duplicarlo permitiría que una fila dijera sector A con una sección del sector B —
  // una inconsistencia que la FK no podría impedir. La cadena
  // task → section → sector → members es la única fuente de verdad, también para permisos.
  sectionId    String    @map("section_id")

  // Etiqueta de "quién lo está viendo", NO un permiso: quién puede escribir lo decide
  // la membresía al sector. Opcional porque una tarea de equipo puede no tener dueño.
  assigneeId   String?   @map("assignee_id")
  createdById  String    @map("created_by_id") // users.id — quién la creó

  company      String?   @db.VarChar(200) // empresas_industrias_v2.nombre_latam, si la tarea es de una empresa
  weeklyPlanId String?   @map("weekly_plan_id") // cuelga la tarea de una celda del calendario macro

  // Desempate de orden dentro de la sección. Ver el comentario SQL: es Float por el
  // drag & drop del Kanban original, que ya no existe.
  sortOrder    Float     @default(0) @map("sort_order")
  completedAt  DateTime? @map("completed_at") // se setea al pasar a done, se limpia al salir
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // section: Restrict — no se borra una sub-sección con tareas dentro, hay que vaciarla.
  // assignee: SetNull — borrar un usuario ya no destruye trabajo, la tarea queda sin
  //   asignar dentro de su sector. Esto sólo es seguro porque el sector, y no la
  //   persona, es lo que sostiene la tarea.
  // createdBy: Restrict — la autoría sí se conserva.
  section    SectorSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  assignee   User?         @relation("TaskAssignee", fields: [assigneeId],  references: [id], onDelete: SetNull)
  createdBy  User          @relation("TaskCreator",  fields: [createdById], references: [id], onDelete: Restrict)
  weeklyPlan WeeklyPlan?   @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)
  comments   TaskComment[]

  @@index([sectionId, status, sortOrder])
  @@index([assigneeId])
  @@index([status, dueDate])
  @@index([weeklyPlanId])
  @@map("tasks")
}

// Feed de interacción de una tarea: el admin deja revisiones, el analista responde.
// Se borra en cascada con la tarea; el autor no, para no perder hilos al borrar gente.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId],   references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
}