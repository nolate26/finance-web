  kpiName     String   @map("kpi_name") @db.VarChar(100)     // Ej: "Commercial loans", "Var %"
  kpiOrder    Int      @map("kpi_order")                      // Orden dentro de la sección

  value       Float?

  header      BankHeader @relation(fields: [ticker, updateDate], references: [ticker, updateDate], onDelete: Cascade)

  @@unique([ticker, updateDate, year, sectionName, kpiName, kpiOrder])
  @@map("bank_kpis")
}


