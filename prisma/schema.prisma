  company     String  @db.VarChar(120)                     // nombre tal como en Pivotes
  weight      Float   @default(1)                          // 1 = pertenece (sumaproducto)
 
  // @@index([indexName]) eliminado: es prefijo de la PK.
  @@id([indexName, company])
  @@index([company])
  @@map("index_membership")
}


model BetaSensitivity {
  company         String   @map("company") @db.VarChar(120) // Ticker de la accion ej "NUTRESA CB Equity"
  factor          String   @map("factor") @db.VarChar(40)   // ej "USDCLP", "IPSA"
  beta            Float    @map("beta")                     // Coeficiente beta calculado
  calculationDate DateTime @map("calculation_date")         // Fecha del cálculo
 
  // @@index([company]) eliminado: es prefijo de la PK.
  @@id([company, factor])
  @@index([factor])
  @@map("beta_sensitivity")
}